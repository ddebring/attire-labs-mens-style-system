---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LookCard from '../../components/LookCard.astro';
import looks from '../../data/looks.json';
const occasionLooks = looks.filter((look) => (look.styles || []).some((item) => ['ethnic','traditional','wedding-guest','tailored','formal'].includes(item)) || (look.occasions || []).some((item) => ['wedding-guest','wedding-functions','family-gathering','formal-event'].includes(item)));
---
<BaseLayout title="Men’s Traditional & Occasionwear — Attire Labs Co." description="Considered traditional menswear, wedding guest outfits and polished looks for family occasions.">
  <div class="site-shell ethnic-page men-ethnic-page">
    <section class="page-intro audience-intro"><div class="eyebrow">THE MEN’S OCCASION FILE</div><h1 class="page-heading serif-display">Traditional, considered.<br /><span>Always yourself.</span></h1><p>Build an outfit around the dress code, venue, weather and how formal the event feels. Keep the fit intentional and the details personal.</p></section>
    <section class="occasion-section"><div class="section-head"><div><div class="eyebrow">DRESS FOR THE INVITATION</div><h2 class="serif-display">The moments worth dressing for.</h2></div><p>Explore traditional styling, wedding guest outfits and polished looks for family gatherings or formal events.</p></div><div class="occasion-grid">
      <a class="occasion-card" href="/looks/?occasion=wedding-guest"><span class="occasion-number">01</span><h3 class="serif-display">Wedding guest</h3><p>Outfits for ceremonies, receptions and the events around them.</p><span class="occasion-arrow">EXPLORE THE EDIT ↗</span></a>
      <a class="occasion-card" href="/looks/?occasion=wedding-functions"><span class="occasion-number">02</span><h3 class="serif-display">Wedding functions</h3><p>Adjust the formality for daytime ceremonies, dinners and receptions.</p><span class="occasion-arrow">EXPLORE THE EDIT ↗</span></a>
      <a class="occasion-card" href="/looks/?occasion=family-gathering"><span class="occasion-number">03</span><h3 class="serif-display">Family gatherings</h3><p>Comfortable, respectful outfits that still feel well put together.</p><span class="occasion-arrow">EXPLORE THE EDIT ↗</span></a>
    </div></section>
    <section class="section"><div class="section-head"><div><div class="eyebrow">TRADITION & TAILORING</div><h2 class="serif-display">Looks to start from.</h2></div><a class="text-link" href="/looks/">ALL MEN’S LOOKS ↗</a></div><div class="look-grid">{occasionLooks.map((look) => <LookCard look={look} />)}</div></section>
  </div>
</BaseLayout>
