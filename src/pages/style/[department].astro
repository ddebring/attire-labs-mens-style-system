---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LookCard from '../../components/LookCard.astro';
import looks from '../../data/looks.json';
export function getStaticPaths() {
  return [{ params: { department: 'him' } }];
}
const title = 'The Men’s Style File';
const intro = 'Considered outfit formulas for the places you go, the people you see and the moments worth dressing for.';
const styleEdits = [
  ['Office & smart casual','Polished formulas for office days, meetings and desk-to-dinner plans','office-smart'],
  ['Date night','Dinner, cinema, bar and first-date outfits that feel intentional','date-night'],
  ['Casual & city','Repeatable city uniforms for coffee, shopping and weekends','casual-everyday'],
  ['College & campus','Simple layers for class, campus events and plans after lectures','college-looks'],
  ['Travel & weekend','Comfortable, considered outfits for airport days and getaways','travel-weekend'],
  ['Athleisure','Movement-first style for training and the rest of the day','athleisure'],
  ['Wedding guest','Traditional occasionwear for ceremonies and receptions','wedding-guest'],
  ['Traditional & occasionwear','Kurtas, tailored ethnic looks and wedding-ready outfits','wedding-functions'],
  ['Job interview','First impressions, interviews and important meetings','interview'],
  ['Party & night out','Sharper outfits for evenings, lounges and social plans','going-out'],
];
const featuredLooks = looks.filter((look) => look.featured).slice(0, 6);
---
<BaseLayout title={`${title} — Attire Labs Co.`} description={intro}>
  <div class="site-shell audience-page men-style-page">
    <section class="page-intro audience-intro"><div class="eyebrow">ATTIRE LABS CO. · MEN’S STYLE FILE</div><h1 class="page-heading serif-display">Dress for the moment.<br /><span>Dress like yourself.</span></h1><p>{intro}</p><a class="text-link" href="/looks/">EXPLORE ALL LOOKS ↗</a></section>
    <section class="occasion-section audience-style-section"><div class="section-head"><div><div class="eyebrow">CHOOSE YOUR CONTEXT</div><h2 class="serif-display">What’s on the plan?</h2></div><p>Browse by occasion. Then refine by place, dress code, style language, season and weather.</p></div><div class="occasion-grid">{styleEdits.map(([name, copy, query], i) => <a class="occasion-card" href={`/looks/?occasion=${encodeURIComponent(query)}`}><span class="occasion-number">{String(i+1).padStart(2,'0')}</span><h3 class="serif-display">{name}</h3><p>{copy}</p><span class="occasion-arrow">EXPLORE THE EDIT ↗</span></a>)}</div></section>
    <section class="section audience-featured-looks"><div class="section-head"><div><div class="eyebrow">THE EDITOR’S STARTING POINT</div><h2 class="serif-display">Start with a look.</h2></div><a class="text-link" href="/looks/">VIEW ALL LOOKS ↗</a></div><div class="look-grid">{featuredLooks.map((look) => <LookCard look={look} />)}</div></section>
  </div>
</BaseLayout>
