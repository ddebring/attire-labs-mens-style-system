---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import products from '../data/products.json';
const availableProducts = products.filter((product) => product.audience === 'him' && product.available !== false);
---
<BaseLayout title="Shop the Pieces — Attire Labs Co." description="Browse menswear pieces from the Attire Labs style file, including clothing, shoes and accessories linked to outfit formulas.">
  <div class="site-shell look-finder-page men-product-page">
    <section class="page-intro finder-intro"><div class="eyebrow">PIECE BY PIECE · MEN’S EDIT</div><h1 class="page-heading serif-display">Shop the pieces<span class="heading-period">.</span></h1><p>Browse the wardrobe building blocks behind the looks. Retailer links open the retailer’s website, where you can confirm price, sizing and availability.</p></section>
    <section class="section finder-section">
      <div class="finder-toolbar men-product-toolbar">
        <label class="finder-search"><span class="sr-only">Search products</span><input id="product-search" type="search" placeholder="Search shirts, trousers, shoes…" /></label>
        <label class="finder-select"><span class="sr-only">Filter by category</span><select id="product-category"><option value="all">All categories</option>{[...new Set(availableProducts.map((p) => p.category))].map((category) => <option value={category.toLowerCase()}>{category}</option>)}</select></label>
        <label class="finder-select"><span class="sr-only">Filter by availability</span><select id="product-sort"><option value="featured">Featured first</option><option value="price-low">Price: low to high</option><option value="price-high">Price: high to low</option><option value="name">Name A–Z</option></select></label>
        <span class="result-count" id="product-count">{availableProducts.length} pieces</span>
      </div>
      <div class="product-grid finder-grid" id="product-grid">{availableProducts.map((product) => <ProductCard product={product} badge={product.featured ? 'STYLE FILE' : ''} />)}</div>
      <p class="empty-state" id="product-empty" hidden>No pieces match that search. Try a different term or category.</p>
    </section>
    <p class="disclosure">Retailer URLs and prices in this starter catalogue are editable placeholders. Replace them with the relevant tracked affiliate URL and current price before publishing.</p>
  </div>
  <script>
    const grid = document.querySelector<HTMLElement>('#product-grid');
    const cards = [...(grid?.querySelectorAll<HTMLElement>('[data-product-card]') || [])];
    const search = document.querySelector<HTMLInputElement>('#product-search');
    const category = document.querySelector<HTMLSelectElement>('#product-category');
    const sort = document.querySelector<HTMLSelectElement>('#product-sort');
    const count = document.querySelector<HTMLElement>('#product-count');
    const empty = document.querySelector<HTMLElement>('#product-empty');
    const params = new URLSearchParams(window.location.search);
    if (search && params.get('q')) search.value = params.get('q') || '';
    function apply() {
      const q = (search?.value || '').trim().toLowerCase();
      const c = category?.value || 'all';
      const visible = cards.filter(card => {
        const matches = (!q || (card.dataset.name || '').includes(q) || (card.dataset.tags || '').includes(q)) && (c === 'all' || (card.dataset.category || '').toLowerCase() === c);
        card.hidden = !matches; return matches;
      });
      visible.sort((a,b) => {
        if (sort?.value === 'price-low') return Number(a.dataset.price||0)-Number(b.dataset.price||0);
        if (sort?.value === 'price-high') return Number(b.dataset.price||0)-Number(a.dataset.price||0);
        if (sort?.value === 'name') return (a.dataset.name||'').localeCompare(b.dataset.name||'');
        return 0;
      });
      visible.forEach(card => grid?.append(card));
      if (count) count.textContent = `${visible.length} piece${visible.length===1?'':'s'}`;
      if (empty) empty.hidden = visible.length>0;
    }
    [search, category, sort].forEach(el => el?.addEventListener(el instanceof HTMLInputElement ? 'input' : 'change', apply));
    apply();
  </script>
</BaseLayout>
