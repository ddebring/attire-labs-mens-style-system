---
import '../styles/global.css';
const {
  title = 'Attire Labs Co. — The Men’s Style File',
  description = 'Occasion-first menswear. Find the right look for work, dates, weekends, travel and weddings.',
} = Astro.props;
const currentPath = Astro.url.pathname;
const activeTopNav = currentPath.startsWith('/style/him/') ? 'him' : currentPath.startsWith('/looks/') ? 'looks' : '';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <button class="menu-trigger" id="menu-open" type="button" aria-expanded="false" aria-controls="site-drawer">
          <span class="menu-glyph" aria-hidden="true"><i></i><i></i><i></i></span><span>MENU</span>
        </button>
        <a class="wordmark" href="/" aria-label="Attire Labs Co home">ATTIRE LABS <span>MEN’S STYLE FILE</span></a>
        <nav class="nav" aria-label="Main navigation">
          <a class:list={{ active: activeTopNav === 'him' }} href="/style/him/">THE STYLE FILE</a>
          <a class:list={{ active: activeTopNav === 'looks' }} href="/looks/">SHOP THE LOOK</a>
          <a href="/looks/?occasion=office-smart">OFFICE</a>
          <a href="/looks/?occasion=date-night">DATE NIGHT</a>
          <a href="/looks/?occasion=wedding-guest">WEDDING</a>
          <a href="/looks/?occasion=casual-everyday">CASUAL</a>
        </nav>
        <div class="header-actions">
          <form class="search-form" action="/looks/" method="get" role="search">
            <label class="sr-only" for="site-search">Search men’s looks</label>
            <input class="search-box" id="site-search" name="q" type="search" placeholder="Search the edit" aria-label="Search looks" />
            <button class="search-submit" type="submit" aria-label="Search">
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
                <circle cx="10.8" cy="10.8" r="6.7" fill="none" stroke="currentColor" stroke-width="1.7" />
                <path d="m16 16 4.2 4.2" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
              </svg>
            </button>
          </form>
          <a class="header-shop-link" href="/looks/">ALL LOOKS ↗</a>
        </div>
      </div>
    </header>

    <div class="drawer-backdrop" id="drawer-backdrop" hidden></div>
    <aside class="side-drawer" id="site-drawer" aria-label="Browse the men's style file" aria-hidden="true" hidden>
      <div class="drawer-head">
        <a class="drawer-wordmark" href="/">ATTIRE LABS <span>MEN’S FILE</span></a>
        <button class="drawer-close" id="menu-close" type="button" aria-label="Close menu">×</button>
      </div>
      <div class="drawer-scroll">
        <p class="drawer-eyebrow">DRESS FOR THE PLAN</p>
        <a class="drawer-feature" href="/looks/">Shop the look <span>↗</span></a>
        <div class="drawer-group drawer-departments">
          <span class="drawer-label">BROWSE BY OCCASION</span>
          <div class="drawer-subitems drawer-occasion-items">
            <a href="/looks/?occasion=office-smart">Office & smart casual</a>
            <a href="/looks/?occasion=business-casual">Business casual</a>
            <a href="/looks/?occasion=date-night">Date night</a>
            <a href="/looks/?occasion=casual-everyday">Casual & everyday</a>
            <a href="/looks/?occasion=college-looks">College & campus</a>
            <a href="/looks/?occasion=travel-weekend">Travel & weekend</a>
            <a href="/looks/?occasion=athleisure">Gym & movement</a>
            <a href="/looks/?occasion=interview">Job interviews</a>
            <a href="/looks/?occasion=brunch">Brunch & daytime plans</a>
            <a href="/looks/?occasion=going-out">Parties & nights out</a>
            <a href="/looks/?occasion=vacation-resort">Vacation & resort</a>
            <a href="/looks/?occasion=wedding-guest">Wedding guest</a>
            <a href="/looks/?occasion=family-gathering">Family gatherings</a>
          </div>
        </div>
        <div class="drawer-group">
          <span class="drawer-label">STYLE & SHOPPING</span>
          <a href="/style/him/">The full style file <span>↗</span></a>
          <a href="/style/ethnic/">Traditional & occasionwear <span>↗</span></a>
          <a href="/shop/">Shop individual pieces <span>↗</span></a>
        </div>
        <div class="drawer-group drawer-search-group">
          <span class="drawer-label">FIND A SPECIFIC LOOK</span>
          <form class="drawer-search" action="/looks/" method="get" role="search">
            <label class="sr-only" for="drawer-search-input">Search looks</label>
            <input id="drawer-search-input" type="search" name="q" placeholder="Try office, monsoon, date night…" />
            <button type="submit" aria-label="Submit search">
              <svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true" focusable="false">
                <circle cx="10.8" cy="10.8" r="6.7" fill="none" stroke="currentColor" stroke-width="1.7" />
                <path d="m16 16 4.2 4.2" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
              </svg>
            </button>
          </form>
        </div>
        <div class="drawer-bottom-links"><a href="/disclosure/">Affiliate disclosure</a><span>Independent style discovery</span></div>
      </div>
    </aside>

    <main><slot /></main>

    <footer class="footer">
      <div class="footer-main">
        <div class="footer-brand-block">
          <a class="wordmark footer-wordmark" href="/">ATTIRE LABS <span>MEN’S STYLE FILE</span></a>
          <p>One style file for the life you actually live. Start with the occasion, build a considered look, then shop each piece directly with the retailer.</p>
        </div>
        <div class="footer-column"><strong>Explore</strong><a href="/looks/">All men’s looks</a><a href="/style/him/">The style file</a><a href="/style/ethnic/">Traditional & occasionwear</a><a href="/shop/">Shop pieces</a></div>
        <div class="footer-column"><strong>By the plan</strong><a href="/looks/?occasion=office-smart">Office</a><a href="/looks/?occasion=date-night">Date night</a><a href="/looks/?occasion=travel-weekend">Travel & weekend</a><a href="/looks/?occasion=interview">Job interview</a><a href="/looks/?occasion=wedding-guest">Wedding guest</a></div>
        <div class="footer-note"><span class="eyebrow">A NOTE ON SHOPPING</span><p>We curate outfit ideas, not inventory. Retailers control the final product page, price, sizes, stock, shipping and returns.</p><a href="/disclosure/">Affiliate disclosure ↗</a></div>
      </div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} Attire Labs Co.</span><span>Men’s style discovery · Independent editorial</span><span>Some links may earn a commission.</span></div>
    </footer>

    <script>
      document.querySelectorAll<HTMLImageElement>('img[data-fallback]').forEach((img) => {
        const fallback = img.nextElementSibling as HTMLElement | null;
        const showFallback = () => {
          const demoSrc = img.getAttribute('data-demo-src');
          if (demoSrc && !img.hasAttribute('data-demo-tried')) {
            img.setAttribute('data-demo-tried', 'true');
            img.setAttribute('src', demoSrc);
            return;
          }
          img.style.display = 'none';
          if (fallback) fallback.hidden = false;
        };
        img.addEventListener('error', showFallback);
        if (img.complete && img.naturalWidth === 0) showFallback();
      });
      const openButton = document.querySelector<HTMLButtonElement>('#menu-open');
      const closeButton = document.querySelector<HTMLButtonElement>('#menu-close');
      const drawer = document.querySelector<HTMLElement>('#site-drawer');
      const backdrop = document.querySelector<HTMLElement>('#drawer-backdrop');
      const closeDrawer = () => {
        if (!drawer || !backdrop || !openButton) return;
        drawer.hidden = true; backdrop.hidden = true; drawer.setAttribute('aria-hidden', 'true');
        openButton.setAttribute('aria-expanded', 'false'); document.body.classList.remove('drawer-open');
      };
      const openDrawer = () => {
        if (!drawer || !backdrop || !openButton) return;
        drawer.hidden = false; backdrop.hidden = false; drawer.setAttribute('aria-hidden', 'false');
        openButton.setAttribute('aria-expanded', 'true'); document.body.classList.add('drawer-open'); closeButton?.focus();
      };
      openButton?.addEventListener('click', () => openButton.getAttribute('aria-expanded') === 'true' ? closeDrawer() : openDrawer());
      closeButton?.addEventListener('click', closeDrawer); backdrop?.addEventListener('click', closeDrawer);
      document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeDrawer(); });
      drawer?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeDrawer));
    </script>
  </body>
</html>
